# หน้าสาธารณะ: https://$PUBLIC_DOMAIN → หน้าหลัก (/) + หมู่บ้านบอท (/sandbox) อ่านอย่างเดียว
# Caddy ขอใบรับรอง Let's Encrypt ให้เอง · ส่งต่อไปที่ monitor โหมด PUBLIC_READONLY (ไม่มีหน้า/ปุ่มสั่งงาน)
{$PUBLIC_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# หน้าหลักฝัง /sandbox ในลิ้นชักของตัวเอง → อนุญาตเฉพาะโดเมนเดียวกัน (เว็บอื่นยังฝังไม่ได้)
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy no-referrer
		-Server
	}
	# เผื่อไว้อีกชั้น: สาธารณะอ่านได้อย่างเดียว
	@write not method GET HEAD
	respond @write 405
	reverse_proxy public:8765
}
